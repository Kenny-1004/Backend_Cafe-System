NODE_ENV=development
PORT=5006
# The API connects as a member of the least-privilege cafe_app role (create it with
#   npm run db:app-login -- cafe_api "<password>"   after npm run db:migrate)
DATABASE_URL=postgres://cafe_api:change-me@localhost:5432/cafe
# Migrations, seeding and admin scripts run as the database owner
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cafe
# Signs staff login tokens. Generate your own: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional
# COOKIE_SECURE=true          # default: true in production (requires HTTPS)
# EXPIRY_JOB_ENABLED=true     # closes orders left open for 24 hours
# LOGIN_RATE_LIMIT=5          # failed sign-ins per minute per IP + username
# ORDER_RATE_LIMIT=20         # kiosk orders per minute per IP
# DEV_STAFF_PASSWORD=cafe12345  # password db:seed gives the demo accounts outside production
