{
  "name": "backend-cafe-system",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Caf\u00e9 Ordering & Inventory System - REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev-passwords": "tsx --env-file=.env scripts/devPasswords.ts",
    "staff:password": "tsx --env-file=.env scripts/setPassword.ts",
    "db:app-login": "tsx --env-file=.env scripts/appLogin.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.2"
  }
}
